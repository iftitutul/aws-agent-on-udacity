# NovaMart multi-agent support - environment
# Resource names (tables, buckets, role, log group) are read automatically from
# the CloudFormation exports of the `udacity-agentcore` stack. Fill in the
# values below as you complete each task (deploy writes most of them for you).

AWS_REGION=us-east-1
PROJECT_NAME=udacity-agentcore

# Phase 3 - Knowledge Bases (copy from the Bedrock console)
RETURNS_KB_ID=JZ7KSRKPMB
SHIPPING_KB_ID=UIGXEIZMGT
WARRANTY_KB_ID=OSO0ASVNMX

# Phase 2/4 - written automatically by `python src/agent_orchestrator.py deploy`
GUARDRAIL_ID=vrqji650xozx
GUARDRAIL_VERSION=5
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:030482683790:runtime/NovaMartSupport_NovaMartOrchestrator-U3lmhH8RJa
MEMORY_ARN=arn:aws:bedrock-agentcore:us-east-1:030482683790:memory/NovaMartSupportMemory-wnvkOvF5To
AGENT_LOG_GROUP=/udacity-agentcore/agents
AGENT_LOG_LEVEL=INFO
AGENT_LOGGING_ENABLED=true
XRAY_ENABLED=true
XRAY_SAMPLING_RATE=1.0
